# OpenRouter — obtén tu key en openrouter.ai/keys (sk-or-...)
LLM_API_KEY=sk-or-...

# Modelo LLM (cambia sin rebuild):
#   gratis:  minimax/minimax-m2.5:free
#   barato:  qwen/qwen3.5-9b
#   calidad: mistralai/mistral-small-2603
LLM_MODEL=minimax/minimax-m2.5:free
LLM_BASE_URL=https://openrouter.ai/api/v1

# PostgreSQL + pgvector
DATABASE_URL=postgresql://ancla:ancla@localhost:5432/ancladb

# Rutas de datos (se sobrescriben en Docker)
MANUALS_PATH=./data/manuals
